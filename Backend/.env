# --- File Storage Configuration (Phase 2 Local Filesystem Storage) ---
STORAGE_ROOT=./storage
DOCUMENT_STORAGE_ROOT=./storage/documents
DATA_STORAGE_ROOT=./storage/data

# --- Backend ---
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins
EXTRA_CORS_ORIGINS=

# --- File uploads (Phase 2 local storage under STORAGE_ROOT) ---
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTS=pdf,docx,txt,md,png,jpg,jpeg

# --- AI models (Phase 3: Analysis Router: Ollama Qwen/Gemma -> Gemini -> Deterministic Grounded Engine) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
TEXT_MODEL=qwen2.5:3b
VISION_MODEL=gemma2:2b
AI_FALLBACK_ENABLED=true
DETERMINISTIC_EXTRACTION_ENABLED=true
# GEMINI_API_KEY=  (optional client or backend key)
GEMINI_MODEL=gemini-2.5-flash

# --- Graph Database Configuration ---
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Embedding Model Configuration (Phase 3) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

# --- Stable Diffusion Forge / Image Studio ---
# Local Forge WebUI API. When backend runs in Docker or on another server,
# set this to the host-visible address (e.g. http://host.docker.internal:7860).
IMAGE_MODEL_URL=http://127.0.0.1:7860
FORGE_URL=http://127.0.0.1:7860
IMAGE_MODEL_TIMEOUT_SECONDS=180
IMAGE_STORAGE=generated_images

# --- Centralized token budgets (see Backend/app/core/token_budgets.py) ---
# All optional; defaults preserve existing behaviour. OLLAMA_NUM_CTX is the
# runtime ceiling (Ollama default 4096) — budgets clamp to it, not to theory.
#RAG_MAX_CONTEXT_TOKENS=3000
#CONTEXT_BUILDER_MAX_TOKENS=
#ANALYSIS_MAX_INPUT_TOKENS=3000
#EMBEDDING_MAX_TOKENS=512
#OLLAMA_NUM_CTX=4096
#SYSTEM_RESERVE_TOKENS=400
#RAG_OUTPUT_RESERVE_TOKENS=512
#STUDENT_MAX_NEW_TOKENS=2048
#QWEN_DEFAULT_NUM_PREDICT=800
